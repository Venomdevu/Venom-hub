# ==================== COMANDO ADD PAINEL ====================
@bot.command(name="addpainel")
@commands.has_permissions(administrator=True)
async def addpainel(ctx, member: discord.Member, tempo: str):
    tempo = tempo.lower()
    agora = datetime.datetime.now()
    
    if tempo == "permanente":
        expira = agora + timedelta(days=36500)
        tipo = "👑 Permanente"
    elif tempo.endswith('d'):
        try:
            dias = int(tempo[:-1])
            expira = agora + timedelta(days=dias)
            tipo = f"📅 {dias} dias"
        except:
            await ctx.send("❌ Formato inválido! Use: 1d, 7d, 30d, 1a, permanente")
            return
    elif tempo.endswith('a'):
        try:
            anos = int(tempo[:-1])
            expira = agora + timedelta(days=anos*365)
            tipo = f"📅 {anos} ano(s)"
        except:
            await ctx.send("❌ Formato inválido! Use: 1d, 7d, 30d, 1a, permanente")
            return
    else:
        await ctx.send("❌ Formato inválido! Use: 1d, 7d, 30d, 1a, permanente")
        return
    
    painel_data[member.id] = {
        "nick": member.name,
        "expira": expira,
        "tipo": tipo
    }
    salvar_dados()
    
    embed = discord.Embed(
        title="✅ PAINEL ADICIONADO COM SUCESSO",
        description=f"Painel admin adicionado para {member.mention}",
        color=0x00ff00
    )
    embed.add_field(name="👤 Usuário", value=f"```{member.name}```", inline=True)
    embed.add_field(name="🆔 ID", value=f"```{member.id}```", inline=True)
    embed.add_field(name="⏰ Duração", value=f"```{tipo}```", inline=True)
    embed.add_field(name="📅 Expira em", value=f"```{expira.strftime('%d/%m/%Y às %H:%M')}```", inline=False)
    embed.set_thumbnail(url=member.avatar.url if member.avatar else member.default_avatar.url)
    embed.set_footer(text="Venom Hub Painel Admin")
    await ctx.send(embed=embed)

