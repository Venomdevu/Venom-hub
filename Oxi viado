                    "expira": datetime.datetime.fromisoformat(v["expira"]),
                    "tipo": v["tipo"]
                }

# ==================== SISTEMA ANTI-SPAM/RAID ====================
spam_control = {}
ANTI_SPAM_RATE = 5
ANTI_SPAM_TIME = 5
RAID_JOIN_LIMIT = 10
RAID_TIME = 10
join_times = []

@bot.event
async def on_message(message):
    if message.author.bot:
        return
    
    if message.author.id not in spam_control:
        spam_control[message.author.id] = []
    
    spam_control[message.author.id].append(time.time())
    recent = [t for t in spam_control[message.author.id] if time.time() - t < ANTI_SPAM_TIME]
    spam_control[message.author.id] = recent
    
    if len(recent) > ANTI_SPAM_RATE:
        try:
            await message.author.timeout(datetime.timedelta(minutes=5), reason="Spam detectado")
            embed = discord.Embed(
                title="🚫 SPAM DETECTADO",
                description=f"{message.author.mention} foi silenciado por 5 minutos.",
                color=0xff0000
            )
            await message.channel.send(embed=embed, delete_after=10)
        except:
            pass
        return
    
    await bot.process_commands(message)

@bot.event
async def on_member_join(member):
    global join_times
    join_times.append(time.time())
    join_times = [t for t in join_times if time.time() - t < RAID_TIME]
    
    if len(join_times) > RAID_JOIN_LIMIT:
        embed = discord.Embed(
            title="🚨 RAID DETECTADA!",
            description="Sistema de proteção ativado. Todos os convites foram desativados.",
            color=0xff0000
        )
        try:
            await member.guild.system_channel.send(embed=embed)
        except:
            pass

