@bot.command(name="sorteio")
@commands.has_permissions(administrator=True)
async def sorteio(ctx, action: str, *, args: str = None):
    if action == "criar":
        await ctx.send("🎉 **CRIANDO SORTEIO**\nQual será o prêmio do sorteio? (Responda em até 30 segundos)")
        
        def check(m):
            return m.author == ctx.author and m.channel == ctx.channel
        
        try:
            premio_msg = await bot.wait_for('message', timeout=30.0, check=check)
            premio = premio_msg.content
            
            await ctx.send("Quantos ganhadores? (Responda com um número)")
            ganhadores_msg = await bot.wait_for('message', timeout=30.0, check=check)
            try:
                ganhadores = int(ganhadores_msg.content)
            except:
                await ctx.send("❌ Número inválido! Cancelando sorteio...")
                return
            
            await ctx.send("Duração do sorteio? (ex: 1h, 30m, 1d)")
            duracao_msg = await bot.wait_for('message', timeout=30.0, check=check)
            duracao = duracao_msg.content.lower()
            
            if duracao.endswith('h'):
                segundos = int(duracao[:-1]) * 3600
            elif duracao.endswith('m'):
                segundos = int(duracao[:-1]) * 60
            elif duracao.endswith('d'):
                segundos = int(duracao[:-1]) * 86400
            else:
                segundos = 3600
            
            embed = discord.Embed(
                title="🎉 SORTEIO INICIADO",
                description=f"**Prêmio:** {premio}\n\nReaja com 🎉 para participar!\n━━━━━━━━━━━━━━━━━━━",
                color=0xf1c40f
            )
            embed.add_field(name="👑 Ganhadores", value=f"```{ganhadores}```", inline=True)
            embed.add_field(name="⏰ Duração", value=f"```{duracao}```", inline=True)
            embed.add_field(name="👤 Criado por", value=f"```{ctx.author.name}```", inline=True)
            embed.set_footer(text="Venom Hub - Sorteios")
            
            msg = await ctx.send(embed=embed)
            await msg.add_reaction("🎉")
            
            await ctx.send(f"✅ Sorteio criado! Aguardando {duracao}...")
            await asyncio.sleep(segundos)
            
            try:
                msg = await ctx.channel.fetch_message(msg.id)
                reaction = discord.utils.get(msg.reactions, emoji="🎉")
                users = await reaction.users().flatten()
                users = [user for user in users if not user.bot]
                
                if len(users) == 0:
                    await ctx.send("❌ Ninguém participou do sorteio!")
                    return
                
                if len(users) < ganhadores:
                    ganhadores = len(users)
                
                winners = random.sample(users, ganhadores)
                winners_mentions = ", ".join([winner.mention for winner in winners])
                
                embed_win = discord.Embed(
                    title="🎉 SORTEIO ENCERRADO!",
                    description=f"**Prêmio:** {premio}\n**Ganhadores:** {winners_mentions}\n━━━━━━━━━━━━━━━━━━━",
                    color=0x00ff00
                )
                embed_win.set_footer(text="Venom Hub - Parabéns aos ganhadores!")
                await ctx.send(embed=embed_win)
            except Exception as e:
                await ctx.send(f"❌ Erro ao finalizar sorteio: {e}")
            
        except asyncio.TimeoutError:
            await ctx.send("❌ Tempo esgotado! Cancelando criação do sorteio...")

