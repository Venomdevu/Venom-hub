# ==================== COMANDO CARGO ====================
@bot.command(name="cargo")
@commands.has_permissions(administrator=True)
async def cargo(ctx, member: discord.Member, *, cargo_nome: str = None):
    if not cargo_nome:
        roles = [r for r in ctx.guild.roles[1:30] if r.name != "@everyone"]
        embed = discord.Embed(
            title="📋 CARGOS DISPONÍVEIS",
            description="Use `!cargo @user @cargo` para atribuir",
            color=0x9b59b6
        )
        for role in roles[:25]:
            embed.add_field(name=role.name, value=f"Membros: {len(role.members)}", inline=True)
        embed.set_footer(text=f"Total: {len(ctx.guild.roles)} cargos")
        await ctx.send(embed=embed)
        return
    
    role = discord.utils.get(ctx.guild.roles, name=cargo_nome)
    if not role:
        if cargo_nome.startswith('<@&') and cargo_nome.endswith('>'):
            try:
                role_id = int(cargo_nome[3:-1])
                role = ctx.guild.get_role(role_id)
            except:
                pass
    
    if not role:
        await ctx.send("❌ Cargo não encontrado!")
        return
    
    if role.position >= ctx.author.top_role.position:
        await ctx.send("❌ Você não pode gerenciar este cargo!")
        return
    
    try:
        await member.add_roles(role)
        embed = discord.Embed(
            title="✅ CARGO ATRIBUIDO",
            description=f"{member.mention} recebeu o cargo **{role.name}**",
            color=0x00ff00
        )
        embed.set_thumbnail(url=member.avatar.url if member.avatar else member.default_avatar.url)
        embed.set_footer(text=f"Autor: {ctx.author.name}")
        await ctx.send(embed=embed)
    except Exception as e:
        await ctx.send(f"❌ Erro ao atribuir cargo: {e}")

